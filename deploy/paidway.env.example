# /opt/paidway/deploy/paidway.env (keys come from the repo .env; this file adds the deploy settings)
PAIDWAY_PUBLIC=1
PAIDWAY_DB=/var/lib/paidway/paidway.sqlite3
PAIDWAY_NESSIE_IDS=/var/lib/paidway/nessie_ids.json
PAIDWAY_NESSIE_TAG=Paidway
PAIDWAY_STATE_DIR=/var/lib/paidway
PAIDWAY_ACTIVITY_FILE=/var/lib/paidway/activity
PAIDWAY_IDLE_MIN=15
